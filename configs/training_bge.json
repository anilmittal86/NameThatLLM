{
  "version": "1.0.0",
  "name": "bge_m3_lora_training",
  "description": "Two-Stage Multi-Head LoRA Fine-Tuning for BGE-M3 (560M XLM-RoBERTa Bidirectional Encoder)",
  "backbone": "BAAI/bge-m3",
  "max_len": 512,
  "hidden_size": 1024,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "lora_target_modules": [
    "query",
    "key",
    "value",
    "dense"
  ],
  "family_margin": 0.35,
  "label_smoothing": 0.05,
  "weight_decay": 0.01,
  "stage1": {
    "enabled": true,
    "epochs": 1,
    "batch_size": 16,
    "gradient_accumulation_steps": 2,
    "lr_lora": 1.5e-4,
    "lr_head": 8e-4,
    "max_samples": 36000
  },
  "stage2": {
    "enabled": true,
    "epochs": 2,
    "batch_size": 4,
    "gradient_accumulation_steps": 4,
    "lr_lora": 3e-5,
    "lr_head": 2e-4,
    "centered_weight": 0.65,
    "supcon_weight": 0.20
  },
  "output_dir": "/kaggle/working/export_bge_m3_lora"
}
