{
  "version": "1.0.0",
  "name": "qwen3_14b_feature_extraction",
  "description": "Configurable Feature & Layer-by-Layer Embedding Extraction Engine for Kaggle Dataset Export",
  "pipeline_mode": "export_embeddings",
  "backbone": "Qwen/Qwen3-14B-Base",
  "keep_layers": 27,
