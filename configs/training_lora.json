{
  "version": "2.0.0",
  "name": "champion_two_stage_lora_14b",
  "description": "Champion Two-Stage Multi-Layer LoRA 14B Trainer (Stage 1 Pool Pre-training on 90k Passages + Stage 2 Contrastive Fine-Tuning with Family Margin Loss)",
  "backbone": "Qwen/Qwen3-14B-Base",
  "keep_layers": 27,
  "layers": [2, 4, 6, 9, 13, 17, 22, 27],
  "max_len": 512,
  "end_id": 151643,
  "lora_r": 32,
  "lora_alpha": 64,
  "lora_dropout": 0.05,
  "lora_target_modules": [
    "q_proj", "k_proj", "v_proj", "o_proj",
    "gate_proj", "up_proj", "down_proj"
  ],
  "family_margin": 0.35,
  "supcon_weight": 0.20,
  "stage1": {
    "enabled": true,
    "lr_lora": 1.5e-4,
    "lr_head": 8e-4,
    "batch_size": 2,
    "gradient_accumulation_steps": 8,
    "epochs": 1,
    "max_samples": 90000,
    "warmup_steps": 100
  },
  "stage2": {
    "enabled": true,
    "lr_lora": 3e-5,
    "lr_head": 2e-4,
    "batch_size": 2,
    "gradient_accumulation_steps": 4,
    "epochs": 2,
    "centered_weight": 0.60,
    "warmup_steps": 50
  },
  "weight_decay": 0.01,
  "output_dir": "export_champion_qwen3_14b"
}
