{
  "version": "1.0.0",
  "name": "two_stage_lora24_training",
  "description": "Production Two-Stage Multi-Layer LoRA24 Trainer (Stage 1 Pool Pre-training + Stage 2 Prompt-Grouped Contrastive Fine-Tuning)",
  "backbone": "Qwen/Qwen3-8B-Base",
  "keep_layers": 24,
  "layers": [2, 4, 6, 8, 12, 16, 20, 24],
  "max_len": 447,
  "end_id": 151643,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "lora_target_modules": [
    "q_proj", "k_proj", "v_proj", "o_proj",
    "gate_proj", "up_proj", "down_proj"
  ],
  "stage1": {
    "enabled": true,
    "lr_lora": 2e-4,
    "lr_head": 1e-3,
    "batch_size": 8,
    "epochs": 1,
    "max_samples": 20000,
    "warmup_steps": 100
  },
  "stage2": {
    "enabled": true,
    "lr_lora": 5e-5,
    "lr_head": 3e-4,
    "batch_size": 4,
    "epochs": 2,
    "centered_weight": 0.5,
    "warmup_steps": 50
  },
  "weight_decay": 0.01,
  "output_dir": "export_lora24"
}

