{
  "version": "2.2.0",
  "name": "qwen3_14b_champion",
  "description": "Full 18-Class Champion Two-Stage LoRA 14B Trainer on Qwen/Qwen3-14B-Base with Hard-Class Loss Upweighting and Empirical Sibling Margin Penalty Boost",
  "backbone": "Qwen/Qwen3-14B-Base",
  "keep_layers": 27,
  "layers": [2, 4, 6, 9, 13, 17, 22, 27],
  "max_len": 384,
  "end_id": 151643,
  "lora_r": 32,
  "lora_alpha": 64,
  "lora_dropout": 0.05,
  "lora_target_modules": [
    "q_proj", "k_proj", "v_proj", "o_proj",
    "gate_proj", "up_proj", "down_proj"
  ],
  "family_margin": 0.40,
  "supcon_weight": 0.25,
  "hard_class_weight": 1.40,
  "output_dir": "export_champion_qwen3_14b",
  "stage1": {
    "enabled": true,
    "lr_lora": 1.5e-4,
    "lr_head": 8e-4,
    "lora_plus_ratio": 2.5,
    "batch_size": 32,
    "gradient_accumulation_steps": 1,
    "epochs": 2,
    "max_samples": 150000,
    "max_hours": 12.0,
    "warmup_steps": 100
  },
  "stage2": {
    "enabled": true,
    "lr_lora": 3e-5,
    "lr_head": 2e-4,
    "lora_plus_ratio": 2.5,
    "batch_size": 2,
    "gradient_accumulation_steps": 4,
    "epochs": 2,
    "centered_weight": 0.65,
    "warmup_steps": 30,
    "n_splits": 5,
    "check_overfitting": true,
    "swa": true
  },
  "weight_decay": 0.01
}
