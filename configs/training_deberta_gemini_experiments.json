{
  "version": "1.1.0",
  "name": "deberta_v3_large_gemini_6a_6b_6c_high_sample_suite",
  "description": "High-Sample (34,000 Gemini + 3,400 Distractor) DeBERTa-v3-Large Suite: EXP-06a (Frozen Public DeBERTa + Head), EXP-06b (Fine-Tuned DeBERTa Direct), EXP-06c (Fine-Tuned DeBERTa Feature Extraction + Full OOF Fisher/MLP/Ridge Sweep)",
  "pipeline_mode": "deberta_specialist_suite",
  "backbone": "microsoft/deberta-v3-large",
  "target_family": "gemini",
  "keep_layers": 24,
  "layers": [3, 6, 9, 12, 15, 18, 21, 24],
  "max_len": 446,
  "samples_per_class": 8500,
  "negative_ratio": 0.10,
  "batch_size": 32,
  "lora_r": 32,
  "lora_alpha": 64,
  "lora_dropout": 0.10,
  "lora_target_modules": [
    "query_proj", "key_proj", "value_proj",
    "pos_key_proj", "pos_query_proj", "dense"
  ],
  "family_margin": 0.45,
  "supcon_weight": 0.20,
  "gate_weight": 0.40,
  "weight_decay": 0.03,
  "output_dir": "export_deberta_gemini_specialist",
  "gate_output_dir": "export_deberta_gemini_gate_mlp",
  "embeddings_output_dir": "export_embeddings_deberta_finetuned",
  "stage1": {
    "enabled": true,
    "lr_lora": 2e-4,
    "lr_head": 1e-3,
    "lora_plus_ratio": 2.0,
    "batch_size": 16,
    "gradient_accumulation_steps": 2,
    "epochs": 1,
    "max_samples": 34000,
    "max_hours": 1.5,
    "warmup_steps": 120
  },
  "stage2": {
    "enabled": true,
    "lr_lora": 4e-5,
    "lr_head": 2.5e-4,
    "lora_plus_ratio": 2.0,
    "batch_size": 4,
    "gradient_accumulation_steps": 2,
    "epochs": 2,
    "centered_weight": 0.65,
    "warmup_steps": 30,
    "n_splits": 5,
    "check_overfitting": true,
    "swa": true
  }
}
